# Copy this file to ".env" (same folder) and fill in your keys. Never commit .env.

# --- Search providers (at least one is required) ---
# Google Places API (New): enable "Places API (New)" in Google Cloud Console and create an API key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# Tavily: https://tavily.com
TAVILY_API_KEY=

# --- LLM for understanding prompts / extracting companies from search results (optional) ---
# Without it the app uses a built-in rule-based prompt parser.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Change only for an OpenAI-compatible provider:
OPENAI_BASE_URL=https://api.openai.com/v1

# --- App settings (all optional) ---
SECRET_KEY=change-me-to-a-long-random-string
HOST=127.0.0.1
PORT=5000
MAX_LEADS_PER_SEARCH=500
DEFAULT_LEAD_COUNT=50
REQUEST_TIMEOUT=15
ENRICH_WORKERS=5
ENRICH_WEBSITES_DEFAULT=true
RESPECT_ROBOTS_TXT=true
CHECK_EMAIL_DOMAIN_MX=true
